	partition Sales = m
		mode: import
		source =
				let
					Source = DeltaLake.Table(Folder.Contents(LakeRoot & "\Tables\gold\fact_sales")),
					Typed = Table.TransformColumnTypes(Source, {
						{"invoice_no", type text},
						{"date_key", Int64.Type},
						{"product_key", Int64.Type},
						{"customer_key", Int64.Type},
						{"country_key", Int64.Type},
						{"is_cancellation", type logical},
						{"quantity", Int64.Type},
						{"unit_price", Currency.Type},
						{"line_amount", Currency.Type},
						{"invoice_ts", type datetimezone},
						{"source_sheet", type text},
						{"source_row", Int64.Type}
					})
				in
					Typed

	annotation PBI_ResultType = Table
