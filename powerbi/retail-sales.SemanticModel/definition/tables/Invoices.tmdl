table Invoices
	lineageTag: f2983641-30a5-46bb-aa89-4618d8b4c91a

	/// Sum of revenue in pounds from each customer's first order inside the two years of data; the customer may have ordered before December 2009.
	measure 'First Order Revenue' = CALCULATE(SUM(Invoices[Order Amount]), Invoices[Customer Order Number] = 1)
		formatString: £#,##0.00
		lineageTag: 29e7d108-5491-439e-85de-edd9a184644b

	/// Sum of revenue in pounds from orders after each customer's first order in the data.
	measure 'Repeat Order Revenue' = CALCULATE(SUM(Invoices[Order Amount]), Invoices[Customer Order Number] > 1)
		formatString: £#,##0.00
		lineageTag: a22cb04a-4dff-4816-b6cf-f5626aa94b57

	/// Repeat order revenue as a share of first and repeat order revenue.
	measure 'Repeat Order Revenue %' = DIVIDE([Repeat Order Revenue], [First Order Revenue] + [Repeat Order Revenue])
		formatString: 0.00%
		lineageTag: d2592a26-e204-4a73-8dbe-6f92cf534a58

	/// Count of distinct customers with a first order inside the two years of data; the customer may have ordered before December 2009.
	measure 'Buying Customers' = CALCULATE(DISTINCTCOUNT(Invoices[Customer Key]), Invoices[Customer Order Number] = 1)
		formatString: #,##0
		lineageTag: 498a1ac9-7966-4816-92a3-042627876c5d

	/// Count of distinct customers with a second order in the data.
	measure 'Repeat Customers' = CALCULATE(DISTINCTCOUNT(Invoices[Customer Key]), Invoices[Customer Order Number] = 2)
		formatString: #,##0
		lineageTag: 10f21718-3311-4f85-b7f5-3bef1cd31f1d

	/// Customers with a second order as a share of customers with a first order in the data.
	measure 'Repeat Customer Rate' = DIVIDE([Repeat Customers], [Buying Customers])
		formatString: 0.00%
		lineageTag: 6f606d7e-3297-4af1-9f7d-d19e358c0f77

	/// Median number of days since the previous order, excluding blank gaps.
	measure 'Median Days Between Orders' = MEDIAN(Invoices[Days Since Previous Order])
		formatString: 0
		lineageTag: 1d6ca1ec-8b6e-4668-a4b1-b9bf6ae9ba12

