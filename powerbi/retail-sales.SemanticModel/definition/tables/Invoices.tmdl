	partition Invoices = m
		mode: import
		source =
				let
					Source = DeltaLake.Table(Folder.Contents(LakeRoot & "\Tables\gold\fact_orders")),
					Typed = Table.TransformColumnTypes(Source, {
						{"invoice_no", type text},
						{"date_key", Int64.Type},
						{"customer_key", Int64.Type},
						{"country_key", Int64.Type},
						{"is_cancellation", type logical},
						{"invoice_ts", type datetimezone},
						{"line_count", Int64.Type},
						{"quantity", Int64.Type},
						{"order_amount", Currency.Type},
						{"customer_order_number", Int64.Type},
						{"days_since_previous_order", Int64.Type}
					})
				in
					Typed

	annotation PBI_ResultType = Table

